[Unit]
Description=Club website Django application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/club-site/backend
EnvironmentFile=/home/ubuntu/club-site/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/club-site/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 config.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target